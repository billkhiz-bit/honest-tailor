# Deny by default: only the folders and files allowed below can be committed. Anything new at the top level
# (a CV workspace, an applications folder, a stray export) stays out unless it is added here on purpose.
/*
!/.claude/
!/.claude-plugin/
!/.github/
!/benchmark/
!/dev/
!/docs/
!/examples/
!/scripts/
!/skills/
!/templates/
!/tests/
!/.gitattributes
!/.gitignore
!/LICENSE
!/PRIVACY.md
!/README.md
!/requirements-dev.txt

# Never committed, even inside an allowed folder
.private-terms
*.pdf
*.docx
__pycache__/
.pytest_cache/
*.pyc
